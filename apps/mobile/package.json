{
  "name": "@kanjime/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm --prefix ../.. run build:shared && npm run build:app",
    "build:app": "tsc -p tsconfig.json && vite build",
    "build:opencv": "scripts/opencv-build/build.sh",
    "build:android": "npm run build && npx cap sync android && export CAPACITOR_ANDROID_STUDIO_PATH=~/Descargas/android-studio/bin/studio.sh && npx cap open android",
    "preview": "vite preview",
    "test": "npm --prefix ../.. run build:shared && npm run test:vitest",
    "test:all": "npm run lint && npm run test && npm run test:e2e",
    "test:e2e": "npm --prefix ../.. run build:shared && VITE_ENABLE_E2E_MOCKS=true vite build && playwright test",
    "test:integration": "npm --prefix ../.. run build:shared && npm run test:integration:app",
    "test:integration:app": "vitest run tests/Integration --exclude=tests/Integration/**/*FirebaseConnection.test.ts",
    "test:integration:live": "npm --prefix ../.. run build:shared && vitest run tests/Integration/**/*FirebaseConnection.test.ts",
    "test:unit": "npm --prefix ../.. run build:shared && npm run test:unit:app",
    "test:unit:app": "vitest run tests/Unit",
    "test:vitest": "rm -rf .vite && vitest run --exclude=tests/**/*FirebaseConnection.test.ts",
    "test:iteration-1": "rm -rf .vite && vitest run tests --exclude=tests/Unit/Calligraphy/** && playwright test",
    "test:iteration-2": "rm -rf .vite && vitest run tests/Unit/Calligraphy",
    "model:export": "python3 ./scripts/model/export-onnx.py",
    "data:download": "node ./scripts/data/download-sources.mjs",
    "data:build": "node ./scripts/data/build-database.mjs",
    "data:prepare": "npm run data:download && npm run data:build",
    "lint": "eslint \"src/**/*.{ts,tsx}\" -f codeframe",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.2",
    "@capacitor/android": "^7.6.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.1",
    "@capacitor/device": "^7.0.5",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.1",
    "@capacitor/preferences": "^7.0.4",
    "@ionic/pwa-elements": "^3.4.0",
    "@ionic/react": "^8.8.4",
    "@ionic/react-router": "^8.8.4",
    "@kanjime/shared": "file:../../packages/shared",
    "fast-xml-parser": "^5.6.0",
    "firebase": "^12.13.0",
    "image-js": "^1.6.0",
    "ionicons": "^8.0.13",
    "js-graph-algorithms": "^1.0.18",
    "onnxruntime-web": "^1.24.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "sql.js": "^1.14.1",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.7.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.4.0",
    "eslint-formatter-codeframe": "^7.32.2",
    "jsdom": "^29.0.2",
    "polished": "^4.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}